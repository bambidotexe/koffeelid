            "value": "Réglages…"
          }
        }
      }
    },
    "Shading": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombrage"
          }
        }
      }
    },
    "Show Onboarding Again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoir l’introduction"
          }
        }
      }
    },
    "Show in menu bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans la barre des menus"
          }
        }
      }
    },
    "Show the desktop folding away as the lid closes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrer le bureau qui se replie quand l’écran se rabat"
          }
        }
      }
    },
    "Show the lid angle in the menu bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’angle de l’écran dans la barre des menus"
          }
        }
      }
    },
    "Simulate a Fold": {
