          }
        }
      }
    },
    "Disarm once finished": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver une fois terminé"
          }
        }
      }
    },
    "Downloading": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement"
          }
        }
      }
    },
    "Downloading: %@ of %@": {
      "localizations": {
