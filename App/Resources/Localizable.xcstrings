{
  "sourceLanguage": "en",
  "strings": {
    "${applicationName} screen on": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} écran allumé"
          }
        }
      }
    },
    "${applicationName} status": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de ${applicationName}"
          }
        }
      }
    },
    "%@ ago": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a %@"
          }
        }
