          }
        }
      }
    },
    "Sleep could not be re-enabled": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille n’a pas pu être réactivée"
          }
        }
      }
    },
    "Sleep lock": {
